# ─────────────────────────────────────────────────────────────
#  LeoMox Website — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string (from neon.tech dashboard)
DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_hex_string

# Server port (Render/Railway override this automatically)
PORT=3000

# Set to "production" when deploying live
NODE_ENV=development

# SMTP — for contact-form email notifications (optional)
# Gmail: use an App Password, not your real password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
CONTACT_TO=contact@leomox.in

# Comma-separated list of allowed CORS origins (leave blank to allow all in dev)
ALLOWED_ORIGINS=https://leomox.in,https://www.leomox.in
