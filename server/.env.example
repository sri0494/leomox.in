# Copy this file to .env and fill in real values. Never commit .env itself.

# ── Neon Postgres ────────────────────────────────────────────────────────
# From your Neon dashboard: Project -> Connection Details -> Connection string
# Use the "pooled" connection string if you deploy to a serverless platform;
# either works fine for a normal Node/Express server like this one.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-PROJECT.neon.tech/YOUR-DB?sslmode=require

# ── Auth ─────────────────────────────────────────────────────────────────
# A long, random, secret string used to sign login session tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# ── Server ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Comma-free single origin (or omit entirely to allow same-origin/no CORS
# restriction, fine when the frontend is served by this same server as it
# is by default in this project).
# CORS_ORIGIN=https://your-domain.com
